{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../packages/authoritative-physics/src/**/*.js",
    "worker-configuration.d.ts"
  ]
}
