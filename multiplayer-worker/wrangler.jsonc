{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ch-folio-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "build": {
    "command": "node scripts/prepare-rapier-worker.mjs"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
