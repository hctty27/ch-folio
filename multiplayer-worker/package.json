{
  "name": "ch-folio-multiplayer-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:rapier": "node scripts/prepare-rapier-worker.mjs",
    "predev": "npm run prepare:rapier",
    "dev": "wrangler dev",
    "predeploy": "npm run prepare:rapier",
    "deploy": "wrangler deploy",
    "predry-run": "npm run prepare:rapier",
    "dry-run": "wrangler deploy --dry-run",
    "pretest": "npm run prepare:rapier",
    "test": "vitest run --config vitest.config.ts",
    "pretypes": "npm run prepare:rapier",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit"
  },
  "dependencies": {
    "@ch-folio/authoritative-physics": "file:../packages/authoritative-physics",
    "@dimforge/rapier3d": "npm:@dimforge/rapier3d-deterministic@0.17.3",
    "@msgpack/msgpack": "^3.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
