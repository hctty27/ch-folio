{
  "name": "bruno-simon-folio-2025",
  "version": "0.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare:wheels": "node scripts/prepare-su7-four-wheels.mjs",
    "prepare:cockpit": "node scripts/generate-cockpit-config.mjs",
    "prepare:authoritative-map": "node scripts/export-authoritative-map.mjs",
    "prebuild": "npm install --no-save --package-lock=true --ignore-scripts --prefer-offline --audit=false --fund=false stylus@0.64.0",
    "dev": "npm run prepare:wheels && npm run prepare:cockpit && vite --mode development",
    "build": "npm run prepare:wheels && npm run prepare:cockpit && vite build --mode production",
    "preview": "vite preview",
    "compress": "node scripts/compress.js static/",
    "test": "npm run test:js && npm run test:su7-convert",
    "test:js": "node --test scripts/test_materialize_vehicle.mjs scripts/test_cockpit_pose.mjs scripts/test_camera_modes.mjs scripts/test_camera_controls_help.mjs scripts/test_multiplayer.mjs scripts/test_multiplayer_transport_isolation.mjs scripts/test_multiplayer_room_url.mjs scripts/test_multiplayer_room_bootstrap.mjs scripts/test_su7_wheel_nodes.mjs scripts/test_su7_four_wheel_glb.mjs scripts/test_su7_four_wheel_controller.mjs scripts/test_authoritative_vehicle_bridge.mjs scripts/test_authoritative_transport.mjs",
    "test:vehicle": "node --test scripts/test_materialize_vehicle.mjs",
    "test:authoritative-vehicle": "node --test packages/authoritative-physics/test/vehicleConfig.test.mjs scripts/test_authoritative_vehicle_bridge.mjs",
    "test:authoritative-transport": "node --test scripts/test_authoritative_transport.mjs",
    "test:authoritative-map": "node --test packages/authoritative-physics/test/map.test.mjs",
    "test:cockpit": "node --test scripts/test_cockpit_pose.mjs",
    "test:camera": "node --test scripts/test_camera_modes.mjs scripts/test_camera_controls_help.mjs",
    "test:multiplayer": "node --test scripts/test_multiplayer.mjs scripts/test_multiplayer_transport_isolation.mjs scripts/test_multiplayer_room_url.mjs scripts/test_multiplayer_room_bootstrap.mjs",
    "test:wheels": "node --test scripts/test_su7_wheel_nodes.mjs scripts/test_su7_four_wheel_glb.mjs scripts/test_su7_four_wheel_controller.mjs",
    "test:su7-convert": "PYTHONPATH=scripts python3 -m unittest scripts/test_convert_su7.py -v"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ch-folio/authoritative-physics": "file:packages/authoritative-physics",
    "@dimforge/rapier3d": "npm:@dimforge/rapier3d-deterministic@0.17.3",
    "@gltf-transform/cli": "^4.1.0",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@tweakpane/plugin-camerakit": "^0.3.0",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "camera-controls": "^3.1.2",
    "dotenv": "^17.2.3",
    "emoji-regex": "^10.4.0",
    "glob": "^13.0.0",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "msgpack-lite": "^0.1.26",
    "normalize-wheel": "^1.0.1",
    "seedrandom": "^3.0.5",
    "sharp": "^0.34.5",
    "stats-gl": "^3.6.0",
    "stylus": "^0.64.0",
    "three": "^0.183.2",
    "tweakpane": "^4.0.4",
    "uuid": "^11.1.0",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-restart": "^0.4.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
